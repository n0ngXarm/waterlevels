# ==========================================
# AQUA COMMAND — PRODUCTION PROFILE (.env.production.example)
# Hardened profile for production deployment behind Reverse Proxy & Tailscale
# ==========================================

DEMO_MODE=false
SEND_DEMO_ALERTS=false
REQUIRE_AUTH_FOR_READ=true

# Network Exposure: Strictly bind to localhost or Tailscale IP only
AQUA_BIND_IP=127.0.0.1
PORT=8787
HOST=127.0.0.1

# High-entropy API Keys (Must be >= 32 characters, generated via CSPRNG)
ADMIN_API_KEY=generate_with_openssl_rand_hex_32_chars_minimum
VIEWER_API_KEY=generate_with_openssl_rand_hex_32_chars_minimum
GATEWAY_INGEST_KEY=generate_with_openssl_rand_hex_32_chars_minimum

# Telegram Production Gateway
TELEGRAM_BOT_TOKEN=your_production_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_production_operations_chat_id
REMINDER_MINUTES=30
TELEGRAM_MIN_GAP_MS=1500

# Telemetry Quality & Health Monitoring
STALE_AFTER_SECONDS=120
QUALITY_ALERT_COOLDOWN_HOURS=6

# PWA Branch Scope (Pilot: Chiang Mai Special Class)
MONITOR_BRANCHES=เชียงใหม่
CHECK_INTERVAL_SECONDS=300
ENABLE_OUTAGE_ALERT=true
ENABLE_QUALITY_ALERT=true
