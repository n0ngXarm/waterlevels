# Copy this file to .env. The Node server reads .env automatically (simple KEY=VALUE lines).
HOST=127.0.0.1
PORT=8787
DEMO_MODE=true
# Required for POST /api/telemetry, /api/test-telegram, /api/alerts/:id/ack
ADMIN_API_KEY=replace-with-a-long-random-value-minimum-24-characters
# Create a bot via @BotFather. Never expose token in frontend code or commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Never automatically forward simulated alerts unless explicitly enabled for tests.
SEND_DEMO_ALERTS=false
# Example operational rules, NOT official PWA or drinking-water regulatory thresholds.
REMINDER_MINUTES=30
TELEGRAM_MIN_GAP_MS=1400
# Stale/live telemetry detection timeout (only when DEMO_MODE=false)
STALE_AFTER_SECONDS=120
