# ==========================================
# AQUA COMMAND — DEMO PROFILE (.env.demo)
# Profile for UI demonstration and local evaluation
# ==========================================

DEMO_MODE=true
SEND_DEMO_ALERTS=false
REQUIRE_AUTH_FOR_READ=false
AQUA_BIND_IP=127.0.0.1
PORT=8787
HOST=127.0.0.1

# Optional Telegram credentials for testing
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin API Key for triggering simulated events
ADMIN_API_KEY=aqua-demo-mode-admin-key-at-least-32-chars-long
CHECK_INTERVAL_SECONDS=300
ENABLE_OUTAGE_ALERT=true
ENABLE_QUALITY_ALERT=true
MONITOR_BRANCHES=เชียงใหม่
