# ==========================================
# PWA Water Notification System Configuration
# ระบบแจ้งเตือนน้ำประปาส่วนภูมิภาค (กปภ.) ไปยัง Telegram
# ==========================================

# 1. Telegram Bot Settings
# นำมาจาก @BotFather บน Telegram
TELEGRAM_BOT_TOKEN=8859573793:AAFcq3rZ2QJCZknQnT2ApN27kK0x4lilUw0

# Chat ID ของผู้รับหลัก (บุคคล หรือ กลุ่ม หรือ Channel เช่น -100xxxxxxxxxx)
# หา Chat ID ได้จากการพิมพ์คุยกับ @userinfobot
TELEGRAM_CHAT_ID=7503983726

# 2. Monitoring Frequency (หน่วยเป็นวินาที)
# แนะนำ: 300 วินาที (5 นาที) หรือ 600 วินาที (10 นาที)
CHECK_INTERVAL_SECONDS=300

# 3. Notification Features
# เปิด/ปิด การแจ้งเตือนประกาศหยุดจ่ายน้ำ ท่อแตก ซ่อมท่อ
ENABLE_OUTAGE_ALERT=true

# เปิด/ปิด การแจ้งเตือนคุณภาพน้ำ RTU ผิดปกติ (pH, ความขุ่น, คลอรีน)
ENABLE_QUALITY_ALERT=true

# 4. Monitored Branches
# กำหนดสาขาที่ต้องการติดตาม (คั่นด้วยจุลภาค เช่น ชลบุรี, เชียงใหม่, ภูเก็ต)
# หรือใส่ * หากต้องการติดตามทุกสาขาทั่วประเทศ
MONITOR_BRANCHES=*

# 5. RTU Water Quality Thresholds (มาตรฐานน้ำประปาดื่มได้ กปภ.)
PH_MIN=6.5
PH_MAX=8.5
NTU_MAX=5.0
CL_MIN=0.2
CL_MAX=2.0

# Cooldown สำหรับการแจ้งเตือนสถานีคุณภาพน้ำเดิมซ้ำ (หน่วยเป็นชั่วโมง)
QUALITY_ALERT_COOLDOWN_HOURS=6
