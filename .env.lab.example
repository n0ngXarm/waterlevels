# ==========================================
# AQUA COMMAND — LAB PROFILE (.env.lab)
# Profile for simulated field integration, edge collector testing & security audit
# ==========================================

DEMO_MODE=false
SEND_DEMO_ALERTS=false
REQUIRE_AUTH_FOR_READ=true
AQUA_BIND_IP=127.0.0.1
PORT=8787
HOST=127.0.0.1

APP_ENV=lab

# Security Keys (Generate using: openssl rand -hex 24)
ADMIN_API_KEY=lab-admin-key-replace-with-random-hex-at-least-32-chars
VIEWER_API_KEY=lab-viewer-key-for-read-only-dashboard-access-32ch

# Per-Gateway Credentials (Separated strictly per Gateway ID)
GATEWAY_TOKEN_GW_CM01_PATAN=patan-lab-gateway-secret-token-32chars
GATEWAY_TOKEN_GW_CM01_NONGSERVER=nongserver-lab-gateway-secret-token-32


# Telegram Gateway (Optional in lab; uses mock queue if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_MINUTES=30
TELEGRAM_MIN_GAP_MS=1400

# Telemetry Stale Threshold
STALE_AFTER_SECONDS=120

# Edge Collector Configuration (Zone A Simulator)
ZONE_A_COLLECTOR_ID=GW-CM01-NONGSERVER
ZONE_A_INGEST_URL=https://fedora.taild7ee11.ts.net/api/v1/ingest/telemetry
ZONE_A_POLL_INTERVAL=5
ZONE_A_BUFFER_DB=data/collector_buffer.db

# Scraper Settings
CHECK_INTERVAL_SECONDS=300
ENABLE_OUTAGE_ALERT=true
ENABLE_QUALITY_ALERT=true
MONITOR_BRANCHES=เชียงใหม่
