# ==========================================
# AQUA COMMAND — FEDORA DEV PROFILE (.env.dev)
# Single-machine local development and simulation lab
# ==========================================

DEMO_MODE=false
SEND_DEMO_ALERTS=false
REQUIRE_AUTH_FOR_READ=false
AQUA_BIND_IP=127.0.0.1
PORT=8787
HOST=0.0.0.0

# Security Keys for Dev Simulation
ADMIN_API_KEY=dev-admin-key-32-chars-long-local-simulation
GATEWAY_INGEST_KEY=dev-gateway-key-32-chars-long-local-simulation
VIEWER_API_KEY=dev-viewer-key-32-chars-long-local-simulation

# Telegram Gateway (Empty in dev to use internal mock queue without network calls)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_MINUTES=30
TELEGRAM_MIN_GAP_MS=1000

# Telemetry Stale Threshold
STALE_AFTER_SECONDS=60

# Zone A Edge Collector Simulator Settings
ZONE_A_STATION_ID=CM-01
ZONE_A_COLLECTOR_ID=GW-CM01-PATAN
ZONE_A_INGEST_URL=http://aqua-command:8787/api/v1/ingest/telemetry
ZONE_A_POLL_INTERVAL=5
ZONE_A_BUFFER_DB=data/zone_a_buffer.db

# Zone B Internal URL
AQUA_COMMAND_URL=http://aqua-command:8787

# Scraper Settings
CHECK_INTERVAL_SECONDS=300
ENABLE_OUTAGE_ALERT=true
ENABLE_QUALITY_ALERT=true
MONITOR_BRANCHES=เชียงใหม่
